{
  "name": "@blamnetwork/web-tiger",
  "version": "0.1.0",
  "description": "Destiny (Tiger) web services — importable library and standalone Nest server",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "proto:generate": "buf generate",
    "proto:watch": "node --watch-path=proto --watch-preserve-output ./scripts/proto-generate.mjs",
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && npm run proto:generate && nest build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "nest start",
    "reports:watch": "node --watch --watch-path=./scripts/reports-watch.mjs --watch-path=./reports_watch.json --watch-preserve-output ./scripts/reports-watch.mjs",
    "start:dev": "npm run prisma:generate && npm run proto:generate && concurrently -k -n proto,nest,tiger -c magenta,cyan,yellow \"npm:proto:watch\" \"nest start --watch\" \"npm:reports:watch\"",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "validate": "npm run check && npm run test && npm run typecheck"
  },
  "dependencies": {
    "@blamnetwork/blf": "^1.1.0-beta.10",
    "@blamnetwork/rsat": "^1.0.0",
    "@bufbuild/protobuf": "^2.13.0",
    "@craftycodie/cstruct": "^2.0.0-alpha.3",
    "@nestjs/common": "11.1.0",
    "@nestjs/core": "11.1.0",
    "@nestjs/platform-express": "11.1.0",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "^6.7.0",
    "@types/yauzl": "^3.4.0",
    "dotenv": "^16.0.1",
    "express": "5.1.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@nestjs/cli": "11.0.7",
    "@nestjs/schematics": "11.0.5",
    "@types/express": "^4.17.13",
    "@types/node": "^16.11.47",
    "concurrently": "^9.2.4",
    "prisma": "^6.7.0",
    "rimraf": "^3.0.2",
    "typescript": "5.8.3",
    "ultracite": "7.7.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "express": "5.1.0"
  }
}
